# =====================================================================
# StyleSphere Production Environment Variables
# =====================================================================

# 1. Django Core Security
# Generate a fresh 50+ char secret key using: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secure-random-secret-key-min-50-characters
DEBUG=False
ALLOWED_HOSTS=stylesphere-store.onrender.com,yourcustomdomain.com
CSRF_TRUSTED_ORIGINS=https://stylesphere-store.onrender.com,https://yourcustomdomain.com

# 2. Production Database (PostgreSQL recommended; e.g. Neon, Supabase, Render Postgres)
DATABASE_URL=postgresql://user:password@hostname:5432/stylesphere_db?sslmode=require

# 3. Transactional Email SMTP (Gmail App Password, Amazon SES, or SendGrid)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=concierge@stylesphere.in
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Style Sphere Atelier <concierge@stylesphere.in>

# 4. Payment Gateway (Razorpay Live Credentials)
RAZORPAY_KEY_ID=rzp_live_your_live_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 5. Merchant UPI & Store Operations
MERCHANT_UPI_ID=stylesphere@upi
MERCHANT_PHONE_NUMBER=+91 9781855165
ADMIN_WHATSAPP_NUMBER=919781855165

# 6. Optional: Initial Superuser Setup (used only during first deployment build)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=ChooseAStrongProductionPassword123!
DJANGO_SUPERUSER_EMAIL=admin@stylesphere.in

# 7. Optional: Cloudinary Cloud Storage for Persistent Product Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
